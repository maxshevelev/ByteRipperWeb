{
  "//": [
    "The application: everything under src/, with the DOM available.",
    "",
    "src/core and src/firmware are typechecked a second time by",
    "tsconfig.core.json, which withholds the DOM lib. That second pass is what",
    "enforces D1's 'no DOM in the domain half' — a lint rule can see an import,",
    "but only the compiler can see a bare `window` or a `Blob` annotation."
  ],
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "types": ["vite/client"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "erasableSyntaxOnly": true,

    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,

    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "benchmarks/paint"]
}
