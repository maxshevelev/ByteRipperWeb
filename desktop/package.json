{
  "name": "byteripper-desktop",
  "productName": "ByteRipper",
  "description": "ByteRipperWeb in a window of its own, for Windows.",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "web": "npm --prefix .. run build && node copy-web.mjs",
    "start": "npm run web && electron .",
    "open": "electron .",
    "dist:win": "npm run web && electron-builder --win --x64 --config electron-builder.config.cjs",
    "test": "node --test test/"
  },
  "devDependencies": {
    "electron": "^44.5.0",
    "electron-builder": "^26.15.3"
  },
  "overrides": {
    "global-agent": "^4.1.3"
  },
  "build": {
    "appId": "com.byteripper.desktop",
    "productName": "ByteRipper",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "update.cjs",
      "release-key.cjs",
      "agent.cjs",
      "agent-endpoint.cjs",
      "relay.cjs",
      "web/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis"
        },
        {
          "target": "portable"
        },
        {
          "target": "zip"
        }
      ],
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "ByteRipper-${version}-setup.exe"
    },
    "electronLanguages": [
      "en-US",
      "ru",
      "de"
    ],
    "portable": {
      "artifactName": "ByteRipper-${version}-portable.exe"
    },
    "asarUnpack": [
      "relay.cjs",
      "agent-endpoint.cjs"
    ]
  }
}
