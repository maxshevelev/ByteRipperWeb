{
  "name": "byteripper-desktop",
  "productName": "ByteRipper",
  "description": "ByteRipperWeb in a window of its own, for Windows.",
  "version": "0.8.5",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "web": "npm --prefix .. run build && node copy-web.mjs",
    "start": "npm run web && electron .",
    "dist:win": "npm run web && electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^44.5.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.byteripper.desktop",
    "productName": "ByteRipper",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "web/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable"
        },
        {
          "target": "zip"
        }
      ],
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "ByteRipper-${version}-portable.exe"
    }
  }
}
