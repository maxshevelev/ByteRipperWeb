# Copy this to `.env.local` — which is never committed — and put this machine's
# own dev-server address in it. Vite reads that file on every start, so the dev
# server comes up on the right address with a plain `npm run dev` and no flags.
#
# The names the server answers to, comma-separated: the machine's own name on
# the network the bench machines share, so they can open
# http://<name>:<port>/ByteRipperWeb/. On a Mac, `scutil --get LocalHostName`
# gives the Bonjour name and `tailscale status` the tailnet one. This is the
# half that keeps Vite's DNS-rebinding guard from refusing the request; the
# binding itself (every interface) is the config's, not this file's.
#
# Leave the file out entirely and the server still runs: it answers localhost
# and its own addresses, and refuses any other Host header.
DEV_SERVER_ALLOWED_HOSTS=your-machine,your-machine.local

# The port, pinned strictly — the address above is a bookmark on the machines
# that use it, so a busy port stops the start rather than silently moving it.
DEV_SERVER_PORT=5173
